# Copy this file to bootstrap/r2.env and fill in your own values.
# Never commit bootstrap/r2.env.

R2_REMOTE_NAME="r2"
R2_BUCKET_NAME="YOUR_R2_BUCKET_NAME"
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"

R2_ACCESS_KEY_ID="YOUR_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="YOUR_SECRET_KEY"

# Prefix inside the bucket that contains the ComfyUI tree.
R2_COMFYUI_PREFIX="comfyui"

# Local ComfyUI installation target on the GPU pod.
COMFYUI_DIR="/workspace/comfyui"

# Start ComfyUI automatically after restoring assets.
START_COMFYUI="true"

# Copy this file to bootstrap/r2.env and fill in your own values.
# Never commit bootstrap/r2.env.

R2_REMOTE_NAME="r2"
R2_BUCKET_NAME="YOUR_R2_BUCKET_NAME"
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"

R2_ACCESS_KEY_ID="YOUR_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="YOUR_SECRET_KEY"

# Prefix inside the bucket that contains the ComfyUI tree.
R2_COMFYUI_PREFIX="comfyui"

# Optional: maximum number of R2 files downloaded at the same time by install_from_r2_v2.sh.
# Defaults to 32 if omitted.
R2_TRANSFERS="32"

# Local ComfyUI installation target. This resolves to a `comfyui/` folder
# under the directory from which the installer is run (for example /workspace).
COMFYUI_DIR="${PWD}/comfyui"

# Start ComfyUI automatically after restoring assets.
START_COMFYUI="true"

# Allows ComfyUI to work behind proxy URLs such as RunPod HTTP services.
COMFYUI_CORS_ORIGIN="*"

# Optional: extra Python packages for custom nodes that do not fully install
# from their own requirements.txt files.
EXTRA_PIP_PACKAGES="GitPython dynamicprompts onnxruntime"
